# MoriBot runtime settings. Copy this file to `.env` and adjust as needed.

# Directory used for config, database, plugins and logs.
MORIBOT_DATA_DIR=./data

# Optional: point the backend at a prebuilt dashboard directory.
# MORIBOT_WEBUI_DIR=./dashboard/dist

# HTTP server overrides. Command line flags take precedence.
MORIBOT_HOST=127.0.0.1
MORIBOT_PORT=6186
MORIBOT_LOG_LEVEL=INFO

# Only trust forwarded headers from your reverse proxy (comma separated).
MORIBOT_FORWARDED_ALLOW_IPS=127.0.0.1

# Language used by CLI backup messages (zh-CN or en-US).
MORIBOT_LOCALE=zh-CN
